# The historical CSV import and replay slice requires no secrets.
# Set an authorized market-data token only when using an HTTPS history endpoint.
# Pass its variable name with --token-env.
AURUM_HISTORY_TOKEN=
# Set runtime profile values only in the local worker environment.
AURUM_MARKET_ENDPOINT=
AURUM_STREAM_TOKEN=
AURUM_BACKFILL_ENDPOINT=
AURUM_BACKFILL_TOKEN=
AURUM_TELEGRAM_TOKEN=
AURUM_TELEGRAM_CHAT_ID=
AURUM_DISCORD_WEBHOOK=
AURUM_API_TOKEN=
